# edge — semantics-coverage score for the rust-port goldens. Exercises:
# spaces inside gate, ms/frac time entries with the clamp at zero, the
# accent velocity cap, prob dropout, swing inherit/override/off, the
# default swing subdivision (no fraction given), clock variety, lane
# lengths that do not divide the step count (polymeter), and pluck
# voices with and without a pitch lane.
tempo 90
bars 2
seed 7
swing 60% 1/8

voice k sample=kick gain=1.1 pan=-0.5
  gate x.x.x..x x..xx..x
  time [-6ms +0.25 0 4.5ms] div=1/8
  hum 2.5

voice s sample=snare
  clock 1/8
  gate ....X..x
  vel [115]
  swing 75% 1/8

voice h sample=hat gain=0.4 pan=1
  gate xxxxx
  vel [100 60 80] div=1/16
  prob 0.6
  swing off

voice b synth=pluck gain=0.9
  clock 1/8
  gate x.x.x.x.
  pitch [f#2 bb1 c3] div=1/4
  hum 1

voice c sample=clap gain=0.7
  gate .x..x...
  swing 55%

voice d synth=pluck gain=0.3 pan=0.6
  clock 1/4
  gate x...
