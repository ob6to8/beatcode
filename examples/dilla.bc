# dilla — one shared swing, then every voice fights it a little:
# kick pushes via a time lane, snare drags 14ms flat, hats humanize
# and drop steps, bass opts out of swing entirely. Per-lane feel
# independence is the whole point of this example.
tempo 88
bars 2
seed 41
swing 58% 1/16

voice kick sample=kick gain=1.0
  gate x..x......x..x..
  time [-4ms 0 -7ms 0] div=1/4
  hum 1

voice snare sample=snare gain=0.9 pan=-0.1
  gate ....x.......x...
  time [+14ms]

voice hat sample=hat gain=0.5 pan=0.25
  gate x.xxx.xx.xx.x.xx
  vel [96 52 70 60 84]
  hum 2
  prob 0.95

voice bass synth=pluck gain=0.8
  gate x..x.x..x..x.x..
  pitch [e1 g1 a1 e1 d2 a1] div=1/8
  swing off
