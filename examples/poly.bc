# poly — lanes at odd lengths drifting against a 4/4 bar:
# 12-step hat gate realigns every 3 bars, 5-entry vel and pitch
# cycles shimmer against everything. Numerology-style evolution
# from nothing but mismatched lane lengths.
tempo 100
bars 4
seed 13

voice kick sample=kick
  gate x...x...x...x...

voice clap sample=clap gain=0.7 pan=-0.2
  gate ....x...........

voice hat sample=hat gain=0.5 pan=0.35
  gate x.xx.x.xx.x.
  vel [100 55 80 62 91]
  hum 1.5

voice bass synth=pluck gain=0.85
  gate x.x..xx..x.x..x.
  pitch [a1 a1 c2 g1 e2] div=1/8
